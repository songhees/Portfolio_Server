{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(mvn *)",
      "Bash(./mvnw *)",
      "Bash(.\\mvnw *)",
      "Bash(mvnw *)",
      "Bash(gradle *)",
      "Bash(./gradlew *)",
      "Bash(.\\gradlew *)",
      "Bash(gradlew *)",
      "Bash(java *)",
      "Bash(javac *)",

      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",

      "Bash(docker build *)",
      "Bash(docker images *)",
      "Bash(docker ps *)",
      "Bash(docker-compose up *)",
      "Bash(docker-compose down *)",

      "Bash(curl *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find . *)",

      "Bash(powershell *)",
      "Bash(pwsh *)",
      "Bash(Get-ChildItem *)",
      "Bash(Get-Content *)",
      "Bash(Select-String *)",
      "Bash(Test-Path *)",
      "Bash(Get-Location)",
      "Bash(Set-Location *)",
      "Bash(New-Item *)",
      "Bash(Copy-Item *)",
      "Bash(Write-Output *)",
      "Bash(Write-Host *)",
      "Bash(ConvertTo-Json *)",
      "Bash(ConvertFrom-Json *)",
      "Bash(Where-Object *)",
      "Bash(ForEach-Object *)",
      "Bash(Select-Object *)",
      "Bash(Sort-Object *)",
      "Bash(Measure-Object *)",
      "Bash(Out-File *)",
      "Bash(Get-Date *)",
      "Bash(Get-Process *)",
      "Bash(Get-Service *)",
      "Bash(Get-Variable *)",
      "Bash(Get-Item *)",
      "Bash(Get-ItemProperty *)",
      "Bash(Resolve-Path *)",
      "Bash(Split-Path *)",
      "Bash(Join-Path *)",
      "Bash(dir *)",
      "Bash(type *)",
      "Bash(echo *)",
      "Bash(tree *)",
      "Bash(ipconfig *)",
      "Bash(netstat *)",
      "Bash(tasklist *)",
      "Bash(where *)",
      "Bash(set *)",
      "Bash(cls)",
      "Bash(ver)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git pull *)",
      "Bash(git push *)",

      "Bash(Remove-Item *)",
      "Bash(Clear-Content *)",
      "Bash(Rename-Item *)",
      "Bash(Move-Item *)",
      "Bash(Stop-Process *)",
      "Bash(Set-ExecutionPolicy *)",
      "Bash(icacls *)",
      "Bash(net *)",
      "Bash(sc *)",
      "Bash(reg *)",
      "Bash(shutdown *)",
      "Bash(rm *)",
      "Bash(del *)",
      "Bash(rd *)"
    ]
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Java 파일 컴파일 확인 중...",
            "command": "powershell -Command \"$json = $input | ConvertFrom-Json; $f = $json.tool_input.file_path; if ($f -match '\\.java$' -and (Test-Path './mvnw')) { $result = & ./mvnw compile -q --no-transfer-progress 2>&1; if ($LASTEXITCODE -ne 0) { $msg = $result -join ' '; @{systemMessage=\"⚠️ 컴파일 오류 발생: $msg\"} | ConvertTo-Json -Compress } }\"",
            "shell": "powershell",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "테스트 파일 감지 중...",
            "command": "powershell -Command \"$json = $input | ConvertFrom-Json; $f = $json.tool_input.file_path; if ($f -match 'Test\\.java$' -and (Test-Path './mvnw')) { $cls = [System.IO.Path]::GetFileNameWithoutExtension($f); @{hookSpecificOutput=@{hookEventName='PostToolUse';additionalContext=\"테스트 파일 '$cls' 가 수정되었습니다. 테스트를 실행하려면: ./mvnw test -Dtest=$cls\"}} | ConvertTo-Json -Depth 3 -Compress }\"",
            "shell": "powershell",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "🔒 보안 검사 중... (커밋 전 staged 코드 분석)",
            "command": "claude --agent security-reviewer",
            "shell": "powershell",
            "timeout": 120,
            "blockOnError": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"$json = $input | ConvertFrom-Json; $cmd = $json.tool_input.command; if ($cmd -match 'drop\\s+table|drop\\s+database|truncate\\s+table' -or $cmd -match 'rm\\s+-rf\\s+[/~]') { @{hookSpecificOutput=@{hookEventName='PreToolUse';permissionDecision='deny';permissionDecisionReason=\"위험한 명령어가 감지되었습니다: $cmd\"}} | ConvertTo-Json -Depth 3 -Compress }\"",
            "shell": "powershell"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$env:PWD/hooks/query_hook.js\"",
            "shell": "powershell",
            "timeout": 300
          }
        ]
      }
    ]
  },

  "env": {
    "JAVA_TOOL_OPTIONS": "-Dfile.encoding=UTF-8",
    "MAVEN_OPTS": "-Xmx1024m"
  }
}
